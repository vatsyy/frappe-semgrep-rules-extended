{
  "schema_name": "rule-contract",
  "schema_version": 1,
  "required": [
    "claim",
    "claim_class",
    "enforcement_ceiling",
    "scope",
    "assumptions",
    "rule_confidence",
    "observed_construct",
    "remediation_or_next_evidence",
    "limitations",
    "provenance",
    "references",
    "message"
  ],
  "claim_classes": [
    "deterministic-defect",
    "proven-security-violation",
    "explicit-policy-violation",
    "review-hotspot",
    "performance-hypothesis"
  ],
  "enforcement_tiers": ["blocking", "monitor", "audit"],
  "scope_required": [
    "languages",
    "framework_versions",
    "paths",
    "file_kinds",
    "analysis_mode",
    "boundary",
    "prerequisites",
    "exclusions"
  ],
  "message_required": ["observation", "claim", "non_claims", "next_action"],
  "universal_gates": [
    "truthful_claim",
    "complete_contract",
    "native_tests",
    "independent_positive",
    "independent_safe_near_miss",
    "declared_compatibility",
    "distinct_value"
  ]
}
